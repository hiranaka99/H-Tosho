# ---- Dependencies ---------------------------------------------------------
node_modules/

# ---- Build output ---------------------------------------------------------
dist/
build/
*.tsbuildinfo
coverage/
playwright-report/
test-results/
.nyc_output/

# ---- Local Impeccable state, caches, reports & previews ---------------------
# Only the DESIGN.md sidecar and the live config are versioned; everything
# else (screenshots, direction notes, process info, detector config) stays
# local so the checkout stays clean for automatic pulls.
**/.impeccable/*
!**/.impeccable/design.json
!**/.impeccable/live/
**/.impeccable/live/*
!**/.impeccable/live/config.json

# ---- Environment / local config & secrets ---------------------------------
.env
.env.*
!.env.example

# ---- Logs & error dumps ----------------------------------------------------
*.log
*.err
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Runtime data & databases (anywhere in the project) -------------------
**/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Archived legacy databases produced by the migration routine
*.migrated

# ---- Downloaded media / galleries ------------------------------------------
downloads/
*.cbz

# ---- Editor / IDE ---------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# ---- OS files -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.codex/hooks.json
